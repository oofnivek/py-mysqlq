# mysqlq credentials — copy to ~/.mysqlq/credentials and fill in real values.
# Each [section] is a profile, selected with `mysqlq --profile <name>`.
# Inline comments must start with ";" (a "#" after a value is kept as part of the value).

[local]
host = 127.0.0.1
port = 3306
user = readonly
password = change-me

[uat]
host = uat-db.example.rds.amazonaws.com
port = 3306                     ; optional, defaults to 3306
user = readonly
password = change-me
socks_proxy = 127.0.0.1:1081    ; optional SOCKS5 proxy (no auth)
